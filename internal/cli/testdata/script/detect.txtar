exec devtooltui detect token.txt
stdout '^jwt \(0\.98\)$'

stdin data.json
exec devtooltui detect
stdout '^json-format \(0\.90\)$'

exec devtooltui detect --json ts.txt
stdout '"id": "timestamp"'
stdout '"ambiguous": false'

! exec devtooltui detect plano.txt
stderr 'format was not recognised'

