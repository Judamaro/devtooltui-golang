# The mode is also accepted as the first argument.
stdin hola.txt
exec devtooltui base64
stdout '^aG9sYQo=$'
stdin hola.b64
exec devtooltui base64 decode
stdout '^hola$'
exec devtooltui base64 --mode decode --variant url url.b64
stdout '^fbff$'

stdin url.txt
exec devtooltui url encode
stdout '^a\+b%26c%0A$'
exec devtooltui url parse full.txt
stdout 'Host: +example.com'
stdout '  q = hello world'

# JWT: token from stdin and secret from a flag.
stdin token.txt
exec devtooltui jwt --secret secreto
stdout '✓ valid HS256 signature'
stdin token.txt
exec devtooltui jwt --secret otro
stdout '✗ invalid signature'

-- hola.txt --
hola
-- hola.b64 --
aG9sYQ==
-- url.b64 --
-_8
-- url.txt --
a b&c
-- full.txt --
https://example.com/x?q=hello+world
-- token.txt --
eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkFuYSBQw6lyZXoiLCJhZG1pbiI6dHJ1ZSwiaWF0IjoxNzY3MjI1NjAwLCJleHAiOjE3NjczMTIwMDB9.yzCN9kY8DE7Uq3esnbzqbXCstU1ucgL8uPKMkzarxWc
