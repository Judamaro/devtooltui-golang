# devtooltui demo for the README. Generated by the "Demo" workflow
# (charmbracelet/vhs-action) or locally with: vhs docs/demo.tape
Output docs/demo.gif

Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 720
Set Padding 16
Set TypingSpeed 40ms
Set Theme "Catppuccin Mocha"

Hide
Type "go build -o /tmp/devtooltui ./cmd/devtooltui && export PATH=/tmp:$PATH && clear"
Enter
Sleep 8s
Show

# Composable CLI
Type `echo '{"b":1,"a":[1,2]}' | devtooltui json-format --sort-keys`
Enter
Sleep 1.5s
Type `devtooltui base64 decode <<< 'aGVsbG8gd29ybGQ='`
Enter
Sleep 1.5s
Type "clear"
Enter

# TUI
Type "devtooltui"
Enter
Sleep 1s
Tab
Tab
Type `{"id":1,"items":["a","b"],"ok":true}`
Sleep 1.5s
Ctrl+P
Sleep 500ms
Type "b64"
Sleep 800ms
Enter
Sleep 500ms
Tab
Tab
Type "hello world"
Sleep 1s
Ctrl+R
Sleep 1.5s
Ctrl+P
Type "diff"
Enter
Sleep 500ms
Tab
Tab
Type "one"
Enter
Type "two"
Tab
Type "one"
Enter
Type "TWO"
Sleep 2s
Ctrl+C
